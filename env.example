# RocketRide connection settings are normally populated by the VS Code extension.
ROCKETRIDE_URI=https://cloud.rocketride.ai
ROCKETRIDE_APIKEY=your-rocketride-api-key

# LLM used by .github/demo.pipe.
ROCKETRIDE_GMI_CLOUD_APIKEY=your-gmi-cloud-api-key

# Local clip summary files indexed by clip_index.pipe.
ROCKETRIDE_CLIP_SUMMARY_PATH=C:/Source/google-io-hackathon/video-data/clip-summaries/*