{
	"components": [
		{
			"id": "chat_1",
			"provider": "chat",
			"config": { "hideForm": true, "mode": "Source", "parameters": {}, "type": "chat" },
			"ui": { "position": { "x": 20, "y": 200 } }
		},
		{
			"id": "llm_gmi_cloud_1",
			"provider": "llm_gmi_cloud",
			"config": {
				"model": "google/gemini-3.1-pro-preview",
				"serverbase": "https://api.gmi-serving.com/v1",
				"apikey": "${GMI_API_KEY}",
				"parameters": {
					"temperature": 0.0
				}
			},
			"input": [{ "lane": "questions", "from": "chat_1" }],
			"ui": { "position": { "x": 240, "y": 200 } }
		},
		{
			"id": "response_answers_1",
			"provider": "response_answers",
			"config": { "laneName": "answers" },
			"input": [{ "lane": "answers", "from": "llm_gmi_cloud_1" }],
			"ui": { "position": { "x": 460, "y": 200 } }
		}
	],
	"project_id": "soccer-coach-pipeline-id",
	"viewport": { "x": 0, "y": 0, "zoom": 1 },
	"version": 1
}
